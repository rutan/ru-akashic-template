{
  "name": "@rutan/akashic-template",
  "version": "1.0.0",
  "private": true,
  "license": "Unlicense",
  "author": "ru_shalm <ru_shalm@hazimu.com>",
  "type": "module",
  "scripts": {
    "start": "node ./scripts/sandbox.cjs",
    "dev": "run-p start watch",
    "build": "run-s lint clean build:*",
    "build:vite": "vite build",
    "build:scan": "pnpm run scan",
    "watch": "run-p watch:*",
    "watch:vite": "vite build -w --mode development",
    "watch:scan": "node ./scripts/scanAsset.ts -w",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "assets": "run-s assets:* scan",
    "assets:convertAssets": "node ./scripts/convertAssets.ts",
    "assets:format": "oxfmt --write ./src/assets/textures",
    "scan": "run-s scan:*",
    "scan:assets": "node ./scripts/scanAsset.ts",
    "scan:format": "node ./scripts/formatGameJson.ts",
    "clean": "run-p clean:*",
    "clean:bundle": "node ./scripts/cleanBundle.ts",
    "lint": "run-s lint:* type-check",
    "lint:oxfmt": "oxfmt --check .",
    "lint:oxlint": "oxlint .",
    "type-check": "run-p type-check:*",
    "type-check:game": "tsc -p tsconfig.game.json",
    "type-check:storybook": "tsc -p tsconfig.storybook.json",
    "type-check:tools": "tsc -p tsconfig.tools.json",
    "format": "run-s format:*",
    "format:oxfmt": "oxfmt --write .",
    "format:oxlint": "oxlint --fix .",
    "deploy:web": "node ./scripts/buildForWeb.ts && deployment-zip -c .deployment-zip.ts -m zip ./tmp/_build",
    "deploy:nicolive": "node ./scripts/archiveForNicoLive.ts",
    "prepare": "husky",
    "precommit": "pnpm run lint"
  },
  "dependencies": {
    "@akashic-extension/akashic-hover-plugin": "^3.2.3",
    "@akashic/akashic-engine": "^3.21.3",
    "@rutan/frame-tween": "^0.7.0",
    "eventmit": "^3.0.6"
  },
  "devDependencies": {
    "@akashic/akashic-cli-commons": "^1.0.5",
    "@akashic/akashic-cli-export": "^2.0.18",
    "@akashic/akashic-cli-scan": "^1.0.7",
    "@akashic/akashic-engine-standalone": "^3.21.3",
    "@akashic/akashic-sandbox": "^0.28.32",
    "@akashic/game-configuration": "^2.5.0",
    "@rutan/deployment-zip": "^0.8.0",
    "@storybook/html": "^10.5.10",
    "@storybook/html-vite": "^10.5.10",
    "@storybook/icons": "^2.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "free-tex-packer-core": "^0.3.9",
    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "^19.2.8",
    "storybook": "^10.5.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
